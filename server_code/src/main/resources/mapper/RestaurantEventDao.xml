<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.RestaurantEventDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.RestaurantEventEntity" id="restaurantEventMap">
        <result property="event_name" column="event_name"/>
        <result property="event_image" column="event_image"/>
        <result property="start_time" column="start_time"/>
        <result property="event_location" column="event_location"/>
        <result property="event_content" column="event_content"/>
        <result property="publish_time" column="publish_time"/>
        <result property="end_time" column="end_time"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.RestaurantEventView" >

		SELECT  restaurantEvent.* FROM restaurant_event  restaurantEvent 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.RestaurantEventView" >
		SELECT * FROM restaurant_event  restaurantEvent <where> 1=1 ${ew.sqlSegment}</where>
	</select>

</mapper>
