<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.RestaurantReservationDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.view.RestaurantReservationView" id="restaurantReservationViewMap">
        <result property="seatName" column="seat_name"/>
        <result property="coverImage" column="cover_image"/>
        <result property="tableLocation" column="table_location"/>
        <result property="capacity" column="capacity"/>
        <result property="storeupNumber" column="storeup_number"/>
        <result property="loginName" column="account"/>
        <result property="name" column="name"/>
        <result property="reservationTime" column="reservation_time"/>
        <result property="deposit" column="deposit"/>
        <result property="paymentStatus" column="payment_status"/>
        <result property="verificationStatus" column="verification_status"/>
        <result property="mobile" column="mobile"/>
    </resultMap>

	<select id="selectListView"
		resultMap="restaurantReservationViewMap" >

		SELECT  restaurantReservation.*, u.mobile AS mobile
		FROM restaurant_reservation  restaurantReservation
		LEFT JOIN users u ON u.login_name = restaurantReservation.account
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultMap="restaurantReservationViewMap" >
		SELECT restaurantReservation.*, u.mobile AS mobile
		FROM restaurant_reservation  restaurantReservation
		LEFT JOIN users u ON u.login_name = restaurantReservation.account
		<where> 1=1 ${ew.sqlSegment}</where>
	</select>



</mapper>
