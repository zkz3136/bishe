@startuml
left to right direction
hide methods
hide stereotypes
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ArrowColor #888888
skinparam Class {
  BackgroundColor #ffffff
  BorderColor #333333
}

entity "用户" as Users
entity "员工" as Staff
entity "管理员" as Admin
entity "菜品信息" as DishInfo
entity "购物车" as Cart
entity "订单" as Orders
entity "菜品评论" as DishReview
entity "餐桌信息" as RestaurantInfo
entity "餐厅预约" as Reservation
entity "车位信息" as Parking
entity "客服会话" as Message
entity "会话消息" as TicketMsg
entity "常见问题" as FAQ
entity "收藏/互动" as Storeup
entity "系统公告" as Notice
entity "菜单配置" as Menu
entity "配置项" as Config

Users "1" -- "N" Orders : 下单
Users "1" -- "N" Cart : 加入
Users "1" -- "N" DishReview : 评论
Users "1" -- "N" Storeup : 收藏/互动
DishInfo "1" -- "N" DishReview : 被评论
DishInfo "1" -- "N" Cart : 被加入
RestaurantInfo "1" -- "N" Reservation : 被预约
Users "1" -- "N" Reservation : 预约
Users "1" -- "1" Message : 会话
Message "1" -- "N" TicketMsg : 发送消息
Users "N" -- "N" FAQ : 查看/搜索
Users "N" -- "N" Notice : 查看公告
RestaurantInfo "1" -- "N" Orders : 就餐/点单
Admin "1" -- "N" Menu : 管理
Admin "1" -- "N" Config : 管理
Staff "1" -- "N" Message : 客服处理
Users "N" -- "N" Parking : 使用/计费

@enduml
